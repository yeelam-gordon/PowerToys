namespace PowerToys
{
    namespace Interop
    {
        delegate void TwoWayPipeIPCReadCallback(String message);
        interface IPeerBoundPipeMessageIPC
        {
            void StartWithPeer(UInt32 processId, String directory, String[] executableNames);
        }

        [default_interface] runtimeclass TwoWayPipeMessageIPCManaged : Windows.Foundation.IClosable, IPeerBoundPipeMessageIPC
        {
            TwoWayPipeMessageIPCManaged(String inputPipeName, String outputPipeName, TwoWayPipeIPCReadCallback _callback);
            void Send(String msg);
            void Start();
            void End();
        }
    }
}