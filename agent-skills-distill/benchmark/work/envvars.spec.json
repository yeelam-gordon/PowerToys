{
  "name": "PowerToys Environment Variables",
  "target": { "app": "PowerToys.EnvironmentVariables" },
  "checks": [
    {
      "id": "user-var-name-shown",
      "priority": "P0",
      "description": "User variable B3_SIGNOFF appears in the Applied Variables list",
      "steps": [
        { "verb": "search", "selector": "B3_SIGNOFF",
          "expect": { "contains": "B3_SIGNOFF", "regex": "\"matchCount\":\\s*[1-9]" } }
      ]
    },
    {
      "id": "user-var-value-shown",
      "priority": "P0",
      "description": "User variable value HelloB3Value is displayed (value column populated)",
      "steps": [
        { "verb": "search", "selector": "HelloB3Value",
          "expect": { "contains": "HelloB3Value", "regex": "\"matchCount\":\\s*[1-9]" } }
      ]
    },
    {
      "id": "system-var-os-shown",
      "priority": "P0",
      "description": "System variable OS value Windows_NT is displayed",
      "steps": [
        { "verb": "search", "selector": "Windows_NT",
          "expect": { "contains": "Windows_NT", "regex": "\"matchCount\":\\s*[1-9]" } }
      ]
    },
    {
      "id": "value-expansion-works",
      "priority": "P1",
      "description": "%NUMBER_OF_PROCESSORS% is expanded in the Applied view (B3_EXPAND -> 16_cores)",
      "steps": [
        { "verb": "search", "selector": "16_cores",
          "expect": { "contains": "16_cores", "regex": "\"matchCount\":\\s*[1-9]" } }
      ]
    },
    {
      "id": "path-user-merge-works",
      "priority": "P1",
      "description": "Merged PATH includes the USER PATH segment (ZZUSERPATHZZ appended to System PATH)",
      "steps": [
        { "verb": "search", "selector": "ZZUSERPATHZZ",
          "expect": { "contains": "ZZUSERPATHZZ", "regex": "\"matchCount\":\\s*[1-9]" } }
      ]
    },
    {
      "id": "system-var-arch-shown",
      "priority": "P1",
      "description": "System variable PROCESSOR_ARCHITECTURE value AMD64 is displayed",
      "steps": [
        { "verb": "search", "selector": "AMD64",
          "expect": { "contains": "AMD64", "regex": "\"matchCount\":\\s*[1-9]" } }
      ]
    },
    {
      "id": "extra-user-var-shown",
      "priority": "P2",
      "description": "Second user variable value AlphaUniqueVal is displayed",
      "steps": [
        { "verb": "search", "selector": "AlphaUniqueVal",
          "expect": { "contains": "AlphaUniqueVal", "regex": "\"matchCount\":\\s*[1-9]" } }
      ]
    }
  ]
}
